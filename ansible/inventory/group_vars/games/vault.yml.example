---
# EXAMPLE ONLY — do not put real secrets in this plaintext file.
#
# Create the real encrypted vault with:
#   cd ansible
#   ansible-vault create inventory/group_vars/games/vault.yml
#
# Edit it later with:
#   ansible-vault edit inventory/group_vars/games/vault.yml

vault_playit_secret_key: "REPLACE_ME"

vault_pterodactyl_db_password: "REPLACE_ME"
vault_pterodactyl_db_root_password: "REPLACE_ME"
vault_pterodactyl_app_key: "base64:REPLACE_ME"
vault_pterodactyl_hashids_salt: "REPLACE_ME"

# Paste the complete Wings configuration generated by:
# Pterodactyl Admin -> Nodes -> games-01 -> Configuration
vault_pterodactyl_wings_config: |
  debug: false
  uuid: REPLACE_ME
  token_id: REPLACE_ME
  token: REPLACE_ME
  # ...paste the rest of config.yml here...
